# Dependencies (installed in container)
**/node_modules

# Build outputs (built in container)
**/.next
**/.turbo
**/dist
**/storybook-static
**/.react-email

# Generated files (generated in container)
packages/database/generated

# Version control
.git
.gitignore

# IDE / Editor
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Environment files (passed via docker-compose env or build args)
**/.env
**/.env.*
!**/.env.example

# Non-essential documentation and tracking
# Note: neither apps/docs/ nor docs/ is excluded — both are workspace packages
# that turbo prune needs in the build context.
tracking/
claudedocs/
LICENSE

# Docker files themselves
**/Dockerfile
docker-compose*.yml
.dockerignore

# CI/CD
.github

# Testing artifacts
**/coverage
**/.nyc_output

# Vercel
.vercel

# AI / automation tooling
.auto-claude/
.claude/
.serena/

# Documentation build artifacts
.contentlayer
.content-collections
.source

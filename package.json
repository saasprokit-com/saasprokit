{
  "name": "saasprokit",
  "version": "1.0.0",
  "bin": {
    "saasprokit": "dist/index.js"
  },
  "files": [
    "dist/index.js"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "check": "ultracite check && turbo check",
    "fix": "ultracite fix && turbo fix",
    "test": "turbo test",
    "analyze": "turbo analyze",
    "boundaries": "turbo boundaries",
    "bump-deps": "npx npm-check-updates --deep -u -x recharts && pnpm install",
    "bump-ui": "npx shadcn@latest add --all --overwrite -c packages/design-system",
    "skills:install": "npx --yes skills experimental_install",
    "migrate": "cd packages/database && npx prisma format && npx prisma generate && npx prisma db push",
    "clean": "git clean -xdf node_modules"
  },
  "devDependencies": {
    "@auto-it/first-time-contributor": "^11.3.6",
    "@biomejs/biome": "2.5.5",
    "@repo/typescript-config": "workspace:*",
    "@turbo/gen": "^2.10.6",
    "@types/node": "^26.1.1",
    "stripe": "^22.3.2",
    "tsup": "^8.5.1",
    "turbo": "^2.10.6",
    "typescript": "^5.9.3",
    "ultracite": "7.9.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.19.0",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0"
  },
  "pnpm": {
    "overrides": {
      "next": "16.2.11",
      "parse5": "^7.2.1",
      "zod": "^4.4.3"
    },
    "ignoredBuiltDependencies": [
      "bcrypt",
      "esbuild"
    ],
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  },
  "type": "module"
}

DATABASE_URL=""
# Direct (non-pooled) endpoint for migrations — only needed when DATABASE_URL
# is pooled (e.g. Neon -pooler)
# DIRECT_URL=""

# Slow-query log threshold in ms (optional, default 500). On Cloudflare Workers
# every query is an HTTPS round trip to Neon, so 200ms+ is normal there; lower
# this for local Postgres over TCP.
# DB_SLOW_QUERY_MS="500"

# =============================================================================
# App Configuration (required)
# =============================================================================

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="MyApp"
NEXT_PUBLIC_DOCS_URL="http://localhost:3004"

# =============================================================================
# Database (required)
# =============================================================================

DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# =============================================================================
# Better Auth (required)
# =============================================================================

BETTER_AUTH_SECRET=""
# Generate with: openssl rand -base64 48
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS=""
# Comma-separated list of trusted origins, e.g. "http://localhost:3000,https://yourdomain.com"

# =============================================================================
# OAuth Providers (optional)
# =============================================================================

# Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# =============================================================================
# Stripe (optional in development)
# =============================================================================

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_FREE_PRICE_ID=""
STRIPE_PRO_PRICE_ID_MONTHLY=""
STRIPE_PRO_PRICE_ID_ANNUAL=""
STRIPE_ENTERPRISE_PRICE_ID_MONTHLY=""
STRIPE_ENTERPRISE_PRICE_ID_ANNUAL=""

# =============================================================================
# Email — Provider Selection
# =============================================================================

# Auto-detected if not set: production + RESEND_API_KEY → resend, otherwise → nodemailer
# EMAIL_PROVIDER="resend"
EMAIL_FROM="noreply@yourdomain.com"

# Resend (production)
RESEND_API_KEY=""

# SMTP / Nodemailer (development — defaults to Maildev on localhost:1025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_POOL="false"

# =============================================================================
# Storage
# =============================================================================

# Provider: "local" (default) or "s3"
STORAGE_PROVIDER="local"

# Local Storage (when STORAGE_PROVIDER="local")
STORAGE_LOCAL_PATH="./public/uploads"
STORAGE_BASE_URL="http://localhost:3000"

# S3 Storage (when STORAGE_PROVIDER="s3")
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET=""
# AWS_S3_PUBLIC_URL=""
# AWS_S3_SIGNED_URL_EXPIRES="3600"

# =============================================================================
# Organization Limits (optional — defaults shown)
# =============================================================================

# MAX_ORGS_PER_USER="10"

# =============================================================================
# Security & Infrastructure (optional)
# =============================================================================

# Cron job authentication (required in production)
CRON_SECRET=""

# Host validation — comma-separated allowed origins
# ALLOWED_ORIGINS=""

# Timeouts (milliseconds)
# HEALTH_CHECK_TIMEOUT_MS="5000"
# ORG_QUERY_TIMEOUT_MS="5000"

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saasprokit-docs",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-29",
  // nodejs_compat is required: fumadocs-mdx's runtime statically imports
  // node:path even though this app never touches the filesystem.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // No routes: a fresh clone deploys to <name>.<account>.workers.dev, which
  // succeeds in any Cloudflare account. To attach a custom domain, add a
  // "routes" entry with "custom_domain": true — wrangler creates the DNS record
  // and certificate on deploy when the zone is in your account.
  "observability": {
    "enabled": true
  },
  // Self-reference lets ISR revalidation call back into the Worker. The
  // service name MUST equal the deployed worker name.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "saasprokit-docs"
    }
  ],
  // Incremental page cache (open-next.config.ts r2IncrementalCache). R2 bucket
  // names are account-scoped: create this one in your own account with
  // `wrangler r2 bucket create saasprokit-docs-cache`.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "saasprokit-docs-cache"
    }
  ]
  // No "vars": the only variable this app reads is NEXT_PUBLIC_APP_NAME, which
  // Next inlines at build time and which falls back to "Docs" when unset.
}

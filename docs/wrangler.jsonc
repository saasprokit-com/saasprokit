{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saasprokit-docs",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // saasprokit.com is a Custom Domain on the separate "saasprokit-site" worker.
  // A zone route on the same hostname takes precedence for the paths it matches,
  // so /docs lands here and every other path still hits the site worker. Two
  // patterns rather than "/docs*", which would also swallow /docsfoo. Deploying
  // these needs Workers Routes edit on the saasprokit.com zone, which the
  // custom-domain-only config did not. docs.saasprokit.com stays attached so the
  // old URLs still reach this worker for the 308s in next.config.mjs.
  "env": {
    "site": {
      "name": "saasprokit-docs",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "saasprokit.com/docs",
          "zone_name": "saasprokit.com"
        },
        {
          "pattern": "saasprokit.com/docs/*",
          "zone_name": "saasprokit.com"
        },
        {
          "pattern": "docs.saasprokit.com",
          "custom_domain": true
        }
      ]
    }
  }
}

{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "javascript": {
    "globals": ["Liveblocks"]
  },
  "linter": {
    "rules": {
      "performance": {
        "noBarrelFile": "off",
        // Deferred: rules newly enabled in ultracite 7.9 that would require a
        // large repo-wide refactor. Adopt them as a separate, focused pass.
        "noJsxPropsBind": "off",
        "noAwaitInLoops": "off"
      },
      "suspicious": {
        "noBitwiseOperators": "off",
        "noControlCharactersInRegex": "off",
        "noLeakedRender": "off",
        "noUnnecessaryConditions": "off",
        "noEqualsToNull": "off",
        "noNestedPromises": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useDestructuring": "off",
        "noIncrementDecrement": "off",
        "useConsistentMethodSignatures": "off",
        "useErrorCause": "off",
        "useConsistentArrowReturn": "off"
      },
      "complexity": {
        "noUselessCatchBinding": "off"
      }
    }
  },
  // useSortedKeys/useSortedAttributes auto-reorder object keys and JSX attributes
  // repo-wide (including intentionally-ordered constants like ORG_ROLES); disabled
  // so the 7.9 tooling bump stays zero-churn.
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off",
        "useSortedAttributes": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**/*",
      "!packages/design-system/components/ui",
      "!packages/design-system/lib",
      "!packages/design-system/hooks",
      "!packages/collaboration/config.ts",
      "!apps/docs/**/*.json",
      "!docs/**/*.json",
      "!apps/email/.react-email",
      "!packages/cms/basehub-types.d.ts",
      "!apps/api/**/*",
      "!packages/storage/magic-bytes.ts",
      "!packages/email/i18n/index.ts",
      "!**/*.test.ts",
      "!**/*.spec.ts"
    ]
  }
}
